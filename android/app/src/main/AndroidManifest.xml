<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/appicon"
        android:label="Fruity Prime"
        android:roundIcon="@mipmap/appicon"
        android:supportsRtl="true"
        android:theme="@style/FruityPrime">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|uiMode|density|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|layoutDirection|locale|fontScale"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- Room previews, rendered in parallel processes (PreviewService.java). -->
        <service
            android:name=".PreviewWorker0"
            android:exported="false"
            android:process=":preview0" />
        <service
            android:name=".PreviewWorker1"
            android:exported="false"
            android:process=":preview1" />
        <service
            android:name=".PreviewWorker2"
            android:exported="false"
            android:process=":preview2" />
        <service
            android:name=".PreviewWorker3"
            android:exported="false"
            android:process=":preview3" />
        <service
            android:name=".PreviewWorker4"
            android:exported="false"
            android:process=":preview4" />
        <service
            android:name=".PreviewWorker5"
            android:exported="false"
            android:process=":preview5" />
        <service
            android:name=".PreviewWorker6"
            android:exported="false"
            android:process=":preview6" />
        <service
            android:name=".PreviewWorker7"
            android:exported="false"
            android:process=":preview7" />
        <service
            android:name=".PreviewWorker8"
            android:exported="false"
            android:process=":preview8" />
        <service
            android:name=".PreviewWorker9"
            android:exported="false"
            android:process=":preview9" />
    </application>
</manifest>
